{
  "name": "gtfs-mcp",
  "version": "1.0.0",
  "description": "MCP server for querying GTFS static schedules and GTFS-RT realtime feeds",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "gtfs-mcp": "dist/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:http": "GTFS_MCP_TRANSPORT=http node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "node evals/run.js evals/results/latest.json --no-cache --repeat 3",
    "eval:view": "promptfoo view",
    "eval:smoke": "node evals/run.js evals/results/smoke.json --no-cache --filter-providers haiku",
    "eval:summary": "node evals/summarize.js evals/results/latest.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "gtfs": "^4.14.1",
    "gtfs-realtime-bindings": "^1.1.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "promptfoo": "^0.125.1",
    "typescript": "^5.8.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.0"
  }
}
