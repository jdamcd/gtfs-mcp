{
  "name": "gtfs-mcp",
  "version": "1.0.2",
  "description": "MCP server for querying GTFS static schedules and GTFS-RT realtime feeds",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "gtfs-mcp": "dist/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:http": "GTFS_MCP_TRANSPORT=http node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "node evals/run.js evals/results/latest.json --no-cache --repeat 3",
    "eval:view": "npx --yes promptfoo@0.125.1 view",
    "eval:smoke": "node evals/run.js evals/results/smoke.json --no-cache --filter-providers haiku",
    "eval:summary": "node evals/summarize.js evals/results/latest.json"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "better-sqlite3": "^13.0.3",
    "gtfs": "^4.21.0",
    "gtfs-realtime-bindings": "^2.2.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.0"
  }
}
